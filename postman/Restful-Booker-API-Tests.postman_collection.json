              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Query params are set via environment variables filter_firstname and filter_lastname",
                  "console.log('Filtering by firstname:', pm.environment.get('filter_firstname'), 'lastname:', pm.environment.get('filter_lastname'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test('Status code is 200', function () {\n    pm.response.to.have.status(200);\n});\n\npm.test('Response is an array', function () {\n    pm.expect(body).to.be.an('array');\n});\n\npm.test('At least one booking returned', function () {\n    pm.expect(body.length).to.be.above(0);\n});\n\npm.test('Each item has numeric bookingid', function () {\n    body.forEach(function (item) {\n        pm.expect(item.bookingid).to.be.a('number');\n    });\n});"
                ]
