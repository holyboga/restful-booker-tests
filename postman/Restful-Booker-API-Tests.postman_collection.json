    {
      "name": "Booking",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test('Status is 200 or 201', () => {\n  pm.expect([200, 201]).to.include(pm.response.code);\n});\n\npm.test('Response has bookingid', () => {\n  pm.expect(body).to.have.property('bookingid');\n  pm.expect(body.bookingid).to.be.a('number');\n});\n\npm.test('Booking data matches request', () => {\n  pm.expect(body.booking.firstname).to.equal('Jim');\n  pm.expect(body.booking.lastname).to.equal('Brown');\n  pm.expect(body.booking.totalprice).to.equal(111);\n});\n\npm.environment.set('bookingId', body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2018-01-01\",\n    \"checkout\": \"2019-01-01\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/booking",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": " All Booking IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test('Status code is 200', () => {\n  pm.response.to.have.status(200);\n});\n\npm.test('Response is an array', () => {\n  pm.expect(body).to.be.an('array');\n});\n\npm.test('Each item has numeric bookingid', () => {\n  body.forEach((item) => {\n    pm.expect(item).to.have.property('bookingid');\n    pm.expect(item.bookingid).to.be.a('number');\n  });\n});"
                ]
              }
            }
          ],
